# ───────── Core ─────────
DATABASE_URL="postgresql://oria:CHANGE_ME@localhost:5432/oria_erp?schema=public"
# Public base URL of the app (used for OAuth redirects, password reset links)
APP_URL="http://localhost:3000"
# 32-byte base64 key used for AES-256-GCM encryption of OAuth tokens / 2FA secrets.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
# Session lifetime in hours (idle sessions expire after SESSION_IDLE_MINUTES)
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
# Shared secret for /api/cron/* endpoints (send as header: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""
# Run the scheduler inside the Node process (eBay sync, overdue tasks, deadline reminders)
ENABLE_INTERNAL_SCHEDULER=true
EBAY_SYNC_INTERVAL_MINUTES=15

# ───────── File storage ─────────
# "local" stores files in STORAGE_DIR (mount a persistent volume in production).
STORAGE_DRIVER=local
STORAGE_DIR=./storage/uploads
MAX_UPLOAD_MB=10

# ───────── Email (password reset, optional) ─────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ORIA FUTURE ERP <no-reply@oriafuture.com>"

# ───────── eBay (developer.ebay.com → Application Keys) ─────────
# SANDBOX or PRODUCTION
EBAY_ENVIRONMENT=SANDBOX
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
EBAY_DEV_ID=""
# The RuName (eBay Redirect URL name) – NOT the URL itself. Configure its "auth accepted URL"
# on developer.ebay.com to: {APP_URL}/api/ebay/oauth/callback
EBAY_RUNAME=""
EBAY_MARKETPLACE_ID=EBAY_GB
